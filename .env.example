# Environment Configuration Template

# General Settings
ENV=development
PROJECT_NAME="Agentic Product Planner & Canvas"

# FastAPI Backend Config
BACKEND_PORT=8000
API_V1_STR=/api

# Database Configuration (Postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pwd
POSTGRES_DB=product_planner
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_secure_pwd@db:5432/product_planner

# Redis Configuration (Broker and Cache)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# LLM Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase Auth Integration
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Frontend Config
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
